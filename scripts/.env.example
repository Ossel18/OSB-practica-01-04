
# Datos del certificado
COUNTRY="ES"
STATE="Cantabria"
CITY="Torrelavega"
ORGANIZATION="IES Ejemplo"
ORGANIZATIONAL_UNIT="Informatica"
COMMON_NAME="practica-https.test"
EMAIL="admin@example.com"

# Dominio e IP elastica
DOMAIN="practica-https.test"
ELASTIC_IP="203.0.113.10"

# Validez del certificado
DAYS=365

# Rutas de los certificados
KEY_PATH="/etc/ssl/private/apache-selfsigned.key"
CERT_PATH="/etc/ssl/certs/apache-selfsigned.crt"
